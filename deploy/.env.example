# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# The address the app lives at; point a DNS record for it at this server.
DOMAIN=hourpower.example.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Turns on Strava sign-in. Make one with: openssl rand -hex 32
SESSION_SECRET=
# Port on the server (localhost only) that an existing web server forwards to, with --shared.
APP_PORT=3100
# Optional: send rides to Garmin via Intervals.icu
INTERVALS_API_KEY=
# Optional, for several riders: cap how many Strava athletes can sign up (blank = no cap; Strava's own app limit applies too).
MAX_ATHLETES=
# Optional: shown on the privacy page.
CONTACT_EMAIL=
# Optional: any random string; used when subscribing to Strava's webhook (see README).
STRAVA_WEBHOOK_TOKEN=
# Optional: time zone for "today" until a rider's own (from Strava) is known, e.g. Australia/Sydney.
APP_TIMEZONE=
