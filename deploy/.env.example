# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# The address the app lives at; point a DNS record for it at this server.
DOMAIN=hourpower.example.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Turns on Strava sign-in. Make one with: openssl rand -hex 32
SESSION_SECRET=
# Encrypts riders' Strava and Garmin tokens on disk. Make one with: openssl rand -hex 32
# Keep it safe: without it, riders must connect Strava and Garmin again. To change it, put the old one
# in TRAINERME_SECRET_KEY_PREVIOUS until every rider has synced once.
TRAINERME_SECRET_KEY=
# Port on the server (localhost only) that an existing web server forwards to, with --shared.
APP_PORT=3100
# Optional: send rides to Garmin via Intervals.icu
INTERVALS_API_KEY=
# Optional: Garmin Connect Developer Program app, to send rides straight to each rider's Garmin Connect
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Optional, for several riders: cap how many Strava athletes can sign up (blank = no cap; Strava's own app limit applies too).
MAX_ATHLETES=
# Optional: shown on the privacy page.
CONTACT_EMAIL=
# Optional: any random string; used when subscribing to Strava's webhook (see README).
STRAVA_WEBHOOK_TOKEN=
# Optional: the id Strava returned when you subscribed; events for any other subscription are ignored.
STRAVA_SUBSCRIPTION_ID=
# Required for Garmin's notifications: add ?token=<this> to the webhook URLs in Garmin's portal. openssl rand -hex 24
GARMIN_WEBHOOK_TOKEN=
# The server's owner: your Strava athlete id (the number in strava.com/athletes/<id>). Sees the admin dashboard and uses
# INTERVALS_API_KEY. Nobody becomes owner by signing in first; leave blank and the admin dashboard is off.
OWNER_ATHLETE_ID=
# Optional: admin dashboard data at /api/admin/stats for a tool outside the browser (the owner, signed in, needs nothing).
# Make one with: openssl rand -hex 32
ADMIN_TOKEN=
# Optional: website and app traffic on the admin dashboard, from Cloudflare (API token with Zone > Analytics > Read).
CLOUDFLARE_API_TOKEN=
# Defaults to hourpowerapp.cc's zone; set only for another domain.
CLOUDFLARE_ZONE_ID=
# Optional: the public website's address, if not www.hourpowerapp.cc.
WEBSITE_HOST=
# Optional: time zone for "today" until a rider's own (from Strava) is known, e.g. Australia/Sydney.
APP_TIMEZONE=
