# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# The address the app lives at; point a DNS record for it at this server.
DOMAIN=hourpower.example.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Turns on Strava sign-in. Make one with: openssl rand -hex 32
SESSION_SECRET=
# Port on the server (localhost only) that an existing web server forwards to, with --shared.
APP_PORT=3100
# Optional: send rides to Garmin via Intervals.icu
INTERVALS_API_KEY=
