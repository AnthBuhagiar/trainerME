# Copy to .env.local and fill in from https://www.strava.com/settings/api
# Never commit .env.local: it holds your Client Secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
INTERVALS_API_KEY=
# Optional: Garmin Connect Developer Program app (developer portal), to send workouts straight to Garmin
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
APP_URL=http://localhost:3000
