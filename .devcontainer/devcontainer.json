{
  "name": "Hour Power",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Hour Power",
      "onAutoForward": "notify"
    }
  },
  "secrets": {
    "STRAVA_CLIENT_ID": {
      "description": "Client ID of your Strava API app (strava.com/settings/api)",
      "documentationUrl": "https://www.strava.com/settings/api"
    },
    "STRAVA_CLIENT_SECRET": {
      "description": "Client Secret of your Strava API app. Stored by GitHub, never in the repo.",
      "documentationUrl": "https://www.strava.com/settings/api"
    },
    "INTERVALS_API_KEY": {
      "description": "Optional. Intervals.icu API key (Settings → Developer Settings) to send workouts on to Garmin Connect.",
      "documentationUrl": "https://intervals.icu/settings"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "postStartCommand": "nohup bash -c 'npm run dev > /tmp/hour-power.log 2>&1 &'"
}
